    if(x>=thr) return Math.max(0,s+x-b);
    return Math.max(0,s+thr-b)*(x/thr);
  }
  function project(x){
    const sum=P.reduce((a,p)=>a+x[p],0), other=Math.max(0,100-sum);
    return cons.map(c=>{
      const raw={}; P.forEach(p=>raw[p]=f(c.base[p],x[p],nat[p]));
      let tot=P.reduce((a,p)=>a+raw[p],0)+other;
      const k=tot>0?100/tot:0;
      const share={}; P.forEach(p=>share[p]=raw[p]*k);
      // candidate level (independents split by baseline weights)
      const cands=[];
      P.forEach(p=>{
        if(p!=='IND') cands.push({p,s:share[p]});
        else if(c.inds.length) c.inds.forEach(w=>cands.push({p,s:share.IND*w/c.base.IND}));
        else cands.push({p,s:share.IND});
      });
      let w=null;
      cands.forEach(cd=>{ if(!w||cd.s>w.s+1e-12) w=cd; });
      return {n:c.n,share,win:w.p,winShare:w.s};
    });
  }
  function seats(res){ const s={}; P.forEach(p=>s[p]=0); res.forEach(r=>s[r.win]++); return s; }
  return {P,nat,cons,project,seats,f};
}))(D);
const PARTY=Object.fromEntries(D.parties.map(p=>[p.id,p]));
const ORDER=D.parties.map(p=>p.id);          // default strength: fixed order
const N=19, MAJ=10, CAP=50;
const NAT=E.nat;
let X=Object.assign({},NAT);
let res=[], seats={}, mode='winner', sel=null, picked=new Set();
const $=id=>document.getElementById(id);
const f1=v=>v.toFixed(1);
const lab=p=>`${PARTY[p].name} (${p})`;

/* ---------- inputs ---------- */
function otherVal(){const o=100-ORDER.reduce((a,p)=>a+X[p],0);return o<1e-9?0:o}
const inputsEl=$('inputs');
ORDER.forEach(p=>{
  const r=document.createElement('div');r.className='row';r.dataset.p=p;
  r.innerHTML=`<div class="rt"><span>${lab(p)}</span><label class="num"><input type="text" inputmode="decimal" aria-label="${PARTY[p].name} vote share"><span>%</span></label></div><input type="range" min="0" max="50" step="0.1" aria-label="${PARTY[p].name} slider" style="--c:${PARTY[p].color}">`;
  inputsEl.appendChild(r);
});
const orow=document.createElement('div');orow.className='row';orow.id='orow';
orow.innerHTML=`<div class="rt"><span>Other</span><label class="num"><input type="text" readonly tabindex="-1" aria-label="Other vote share (remainder)"><span>%</span></label></div><input type="range" class="lock" min="0" max="50" step="0.1" disabled aria-label="Other slider (remainder, locked)" style="--c:var(--track)">`;
inputsEl.appendChild(orow);
function clampTo(p,v){
  if(!isFinite(v)||v<0)v=0;
  const others=ORDER.reduce((a,q)=>a+(q===p?0:X[q]),0);
  return Math.max(0,Math.min(v,CAP,100-others));
}
function syncInputs(skipBox){
  inputsEl.querySelectorAll('.row[data-p]').forEach(r=>{
    const p=r.dataset.p,rng=r.querySelector('input[type=range]'),box=r.querySelector('input[type=text]');
    rng.value=X[p];rng.style.setProperty('--p',(100*X[p]/CAP)+'%');
    if(box!==skipBox)box.value=f1(X[p]);
  });
  const o=otherVal(),orng=orow.querySelector('input[type=range]');
  orng.value=o;orow.querySelector('input[type=text]').value=f1(o);
}
inputsEl.addEventListener('input',e=>{
  const row=e.target.closest('.row[data-p]');if(!row)return;
  const p=row.dataset.p;
  if(e.target.type==='range'){X[p]=clampTo(p,Math.round(parseFloat(e.target.value)*10)/10);syncInputs();}
  else{const raw=parseFloat(String(e.target.value).replace(',','.'));X[p]=clampTo(p,isNaN(raw)?0:raw);syncInputs(e.target);}
  render();
});
inputsEl.addEventListener('change',e=>{if(e.target.type==='text')syncInputs();});
inputsEl.addEventListener('keydown',e=>{if(e.key==='Enter'&&e.target.type==='text'){syncInputs();e.target.blur();}});
$('reset').onclick=()=>{X=Object.assign({},NAT);syncInputs();render();};

/* ---------- hemicycle ---------- */
function hemicycle(){
  const cx=240,cy=262,rows=[[135,8],[205,11]],R=28,pts=[];
  rows.forEach(([r,n])=>{for(let i=0;i<n;i++){const a=Math.PI-i*Math.PI/(n-1);pts.push({x:cx+r*Math.cos(a),y:cy-r*Math.sin(a),a,r});}});
  pts.sort((u,v)=>v.a-u.a||u.r-v.r);
  const seq=[];ORDER.forEach(p=>{for(let i=0;i<seats[p];i++)seq.push(p)});
  $('hemi').innerHTML=pts.map((q,i)=>`<circle cx="${q.x.toFixed(1)}" cy="${q.y.toFixed(1)}" r="${R}" fill="${PARTY[seq[i]].color}"/>`).join('');
  $('hlegend').innerHTML=ORDER.filter(p=>seats[p]>0).map(p=>`<span><i class="dot" style="background:${PARTY[p].color}"></i>${p}</span>`).join('');
}

/* ---------- table ---------- */
function table(){
  const rows=ORDER.filter(p=>X[p]>=1||seats[p]>0).sort((a,b)=>seats[b]-seats[a]||X[b]-X[a]);
  $('tbody').innerHTML=rows.map(p=>{
    const d=seats[p]-D.seats2025[p];
    const cls=d>0?'pos':d<0?'neg':'zero',txt=d>0?'+'+d:d<0?'−'+Math.abs(d):'0';
    return `<tr><td><i class="dot" style="background:${PARTY[p].color}"></i>${lab(p)}</td><td>${f1(X[p])}%</td><td class="s">${seats[p]}</td><td class="${cls}">${txt}</td></tr>`;
  }).join('');
}

/* ---------- coalition ---------- */
function coalition(){
  const ps=ORDER.filter(p=>seats[p]>0).sort((a,b)=>seats[b]-seats[a]||ORDER.indexOf(a)-ORDER.indexOf(b));
  picked.forEach(p=>{if(!(seats[p]>0))picked.delete(p)});
  $('cbtns').innerHTML=ps.map(p=>`<button type="button" data-p="${p}" class="${picked.has(p)?'on':''}"><i class="dot" style="background:${PARTY[p].color}"></i>${p}</button>`).join('');
  let acc=0,html='';
  ps.filter(p=>picked.has(p)).forEach(p=>{html+=`<div class="seg" style="left:${100*acc/N}%;width:${100*seats[p]/N}%;background:${PARTY[p].color}"></div>`;acc+=seats[p];});
  $('cfill').innerHTML=html;
  $('cmk').style.left=(100*MAJ/N)+'%';
  const l=$('cmkl');l.style.left=(100*MAJ/N)+'%';l.textContent=MAJ;
  $('cstat').innerHTML=`${acc} of ${N} seats`+(acc>=MAJ?` · <b class="maj">Majority</b>`:'');
}
$('cbtns').addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;const p=b.dataset.p;picked.has(p)?picked.delete(p):picked.add(p);coalition();});

/* ---------- map ---------- */
const consEl=$('cons');
const GEO_ORDER=Object.keys(GEO.paths);
consEl.innerHTML=GEO_ORDER.map(n=>`<path data-n="${n}" d="${GEO.paths[n]}" fill-rule="evenodd"></path>`).join('');
const winner25={};E.project(NAT).forEach(r=>winner25[r.n]=r.win);

function mapButtons(){
  const ps=ORDER.filter(p=>seats[p]>0||X[p]>=1).sort((a,b)=>seats[b]-seats[a]||ORDER.indexOf(a)-ORDER.indexOf(b));
  $('mbtns').innerHTML=[['winner','Winner'],['gains','Gains']].concat(ps.map(p=>[p,p])).map(([k,t])=>`<button type="button" data-k="${k}" class="${mode===k?'on':''}">${PARTY[k]?`<i class="dot" style="background:${PARTY[k].color}"></i>`:''}${t}</button>`).join('');
}
$('mbtns').addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;mode=b.dataset.k;mapButtons();paint();});
function paint(){
  const byN=Object.fromEntries(res.map(r=>[r.n,r]));
  let lo=0,hi=0;
  if(PARTY[mode]){const v=res.map(r=>r.share[mode]);lo=Math.min(...v);hi=Math.max(...v);}
  consEl.querySelectorAll('path').forEach(el=>{
    const r=byN[el.dataset.n];let fill,op=1;
    if(mode==='winner')fill=PARTY[r.win].color;
    else if(mode==='gains'){const g=r.win!==winner25[r.n];fill=g?PARTY[r.win].color:'var(--none)';}
    else{fill=PARTY[mode].color;op=hi>lo?0.12+0.88*(r.share[mode]-lo)/(hi-lo):1;}
    el.setAttribute('fill',fill);el.setAttribute('fill-opacity',op.toFixed(3));
  });
  let lg='';
  if(mode==='winner')lg=ORDER.filter(p=>seats[p]>0).map(p=>`<span><i class="dot" style="background:${PARTY[p].color}"></i>${p}</span>`).join('');
  else if(mode==='gains'){const gp=ORDER.filter(p=>res.some(r=>r.win===p&&r.win!==winner25[r.n]));lg=gp.map(p=>`<span><i class="dot" style="background:${PARTY[p].color}"></i>${p}</span>`).join('');}
  else{const c=PARTY[mode].color;lg=`<span class="grad">${f1(lo)}%<i style="background:linear-gradient(to right,${c}1f,${c})"></i>${f1(hi)}%</span>`;}
  $('mlegend').innerHTML=lg;
  if(sel)showTip(sel,null);
}
const tip=$('tip'),wrap=$('mapwrap');
let lastXY=null;
function showTip(name,xy){
  const r=res.find(q=>q.n===name);if(!r)return;
  if(xy)lastXY=xy;
  const rows=ORDER.filter(p=>r.share[p]>=1||r.win===p).sort((a,b)=>r.share[b]-r.share[a]);
  tip.innerHTML=`<div class="t"><span>${name}</span></div>`+rows.map(p=>`<div class="r${r.win===p?' w':''}"><i class="dot" style="background:${PARTY[p].color}"></i><span>${p}</span><b class="p">${f1(r.share[p])}%</b></div>`).join('');
  tip.style.display='block';
  const w=wrap.clientWidth,h=wrap.clientHeight,tw=tip.offsetWidth,th=tip.offsetHeight;
  let x=lastXY[0]+10,y=lastXY[1]+10;
  if(x+tw>w)x=Math.max(0,lastXY[0]-tw-10);
  if(y+th>h)y=Math.max(0,h-th);
  tip.style.left=x+'px';tip.style.top=y+'px';
}
function hideTip(){tip.style.display='none';consEl.querySelectorAll('.sel').forEach(e=>e.classList.remove('sel'));sel=null;}
consEl.addEventListener('click',e=>{
  if(moved){moved=false;return;}
  const el=e.target.closest('path');if(!el)return;e.stopPropagation();
  consEl.querySelectorAll('.sel').forEach(x=>x.classList.remove('sel'));
  el.classList.add('sel');sel=el.dataset.n;
  const b=wrap.getBoundingClientRect();showTip(sel,[e.clientX-b.left,e.clientY-b.top]);
});
document.addEventListener('click',e=>{if(!tip.contains(e.target)&&!e.target.closest('#cons'))hideTip();});
document.addEventListener('keydown',e=>{if(e.key==='Escape')hideTip();});

/* ---------- zoom & pan ---------- */
let moved=false;
const svgEl=$('map'),MW=GEO.w,MH=GEO.h,MAXZ=40;
let vcx=MW/2,vcy=MH/2,zoom=1,cw=1,ch=1;
const fitW=()=>Math.max(MW*1.04,MH*1.04*(cw/ch));
function view(){
  const vw=fitW()/zoom,vh=vw*ch/cw;
  vcx=Math.min(MW,Math.max(0,vcx));vcy=Math.min(MH,Math.max(0,vcy));
  svgEl.setAttribute('viewBox',`${(vcx-vw/2).toFixed(2)} ${(vcy-vh/2).toFixed(2)} ${vw.toFixed(2)} ${vh.toFixed(2)}`);
  svgEl.style.touchAction=zoom>1.001?'none':'pan-y';
  svgEl.style.cursor=zoom>1.001?'grab':'';
}
function zoomAt(px,py,f){
  const vw=fitW()/zoom,vh=vw*ch/cw,mx=vcx-vw/2+px/cw*vw,my=vcy-vh/2+py/ch*vh;
  zoom=Math.min(MAXZ,Math.max(1,zoom*f));
  const nw=fitW()/zoom,nh=nw*ch/cw;
  vcx=mx-(px/cw-.5)*nw;vcy=my-(py/ch-.5)*nh;
  if(zoom<=1.0001){zoom=1;vcx=MW/2;vcy=MH/2;}
  hideTip();view();
}
function panBy(dx,dy){const vw=fitW()/zoom;vcx-=dx/cw*vw;vcy-=dy/cw*vw;view();}
function measure(){cw=wrap.clientWidth||1;ch=wrap.clientHeight||1;view();}
new ResizeObserver(measure).observe(wrap);measure();
$('zin').onclick=()=>zoomAt(cw/2,ch/2,1.6);
$('zout').onclick=()=>zoomAt(cw/2,ch/2,1/1.6);
$('zrs').onclick=()=>{zoom=1;vcx=MW/2;vcy=MH/2;hideTip();view();};
svgEl.addEventListener('wheel',e=>{
  e.preventDefault();
  const b=wrap.getBoundingClientRect(),k=e.ctrlKey?0.01:0.002,dy=e.deltaMode===1?e.deltaY*33:e.deltaY;
  zoomAt(e.clientX-b.left,e.clientY-b.top,Math.exp(-dy*k));
},{passive:false});
svgEl.addEventListener('dblclick',e=>{e.preventDefault();const b=wrap.getBoundingClientRect();zoomAt(e.clientX-b.left,e.clientY-b.top,2);});
const ptrs=new Map();
svgEl.addEventListener('pointerdown',e=>{ptrs.set(e.pointerId,{x:e.clientX,y:e.clientY,sx:e.clientX,sy:e.clientY});moved=false;});
window.addEventListener('pointermove',e=>{
  const p=ptrs.get(e.pointerId);if(!p)return;
  if(ptrs.size>=2){
    const o=[...ptrs.entries()].find(([id])=>id!==e.pointerId)[1];
    const d0=Math.hypot(p.x-o.x,p.y-o.y),m0x=(p.x+o.x)/2,m0y=(p.y+o.y)/2;
    const d1=Math.hypot(e.clientX-o.x,e.clientY-o.y),m1x=(e.clientX+o.x)/2,m1y=(e.clientY+o.y)/2;
    p.x=e.clientX;p.y=e.clientY;moved=true;
    const b=wrap.getBoundingClientRect();
    if(d0>0)zoomAt(m1x-b.left,m1y-b.top,d1/d0);
    panBy(m1x-m0x,m1y-m0y);return;
  }
  if(zoom<=1.001)return;
  if(!moved&&Math.hypot(e.clientX-p.sx,e.clientY-p.sy)<4)return;
  if(!moved){moved=true;hideTip();}
  panBy(e.clientX-p.x,e.clientY-p.y);p.x=e.clientX;p.y=e.clientY;
});
['pointerup','pointercancel'].forEach(n=>window.addEventListener(n,e=>ptrs.delete(e.pointerId)));

/* ---------- render ---------- */
function render(){
  res=E.project(X);seats=E.seats(res);
  if(PARTY[mode]&&!(seats[mode]>0||X[mode]>=1))mode='winner';
  hemicycle();table();coalition();mapButtons();paint();
}
syncInputs();render();
</script>
