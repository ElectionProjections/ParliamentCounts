<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Cayman Islands Seat Projector</title>
<style>
:root{--bg:#f3f4f6;--card:#fff;--fg:#1c2230;--muted:#69717f;--border:#dadde3;--track:#d3d8df;--green:#16803f;--red:#c52f37;--land:#c4cad3;--none:#e6e8ec;--soft:#f3f4f6;--shadow:0 6px 18px rgba(20,25,35,.18)}
@media (prefers-color-scheme:dark){:root{--bg:#13161b;--card:#1c2027;--fg:#e8eaee;--muted:#9aa2ae;--border:#323843;--track:#69727f;--green:#4cc27f;--red:#ff6b72;--land:#5c6572;--none:#2c313a;--soft:#262b33;--shadow:0 6px 18px rgba(0,0,0,.5)}}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--fg);font:14px/1.4 system-ui,-apple-system,"Segoe UI",Roboto,Helvetica,Arial,sans-serif}
main{max-width:760px;margin:0 auto;padding:14px 12px 28px;overflow-x:hidden}
h1{text-align:center;font-size:22px;margin:6px 0 10px;font-weight:700}
h2{text-align:center;font-size:17px;margin:0 0 10px;font-weight:650}
.card{background:var(--card);border:1px solid var(--border);border-radius:10px;padding:12px;margin:0 0 12px}
.loc{display:flex;justify-content:center;align-items:center;gap:14px;margin:0 0 12px;min-height:90px}
.loc svg{width:220px;max-width:62vw;height:auto;display:block}
.loc img{width:50px;height:auto;display:block;border:1px solid var(--border);border-radius:3px}
.facts{display:grid;grid-template-columns:1fr 1fr;padding:0}
.fact{padding:12px 8px;text-align:center;min-width:0}
.fact+.fact{border-left:1px solid var(--border)}
.lab{font-size:10.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);font-weight:600}
.big{font-size:26px;font-weight:700;font-variant-numeric:tabular-nums;line-height:1.2;margin:3px 0 2px}
.big small{font-size:13px;color:var(--muted);font-weight:500}
.sub{font-size:11.5px;color:var(--muted)}
.bar{height:6px;border-radius:99px;background:var(--track);margin:6px auto 6px;max-width:150px;overflow:hidden}
.bar i{display:block;height:100%;border-radius:99px;background:var(--green)}
details.sys{padding:0}
details.sys summary{list-style:none;cursor:pointer;text-align:center;font-weight:600;padding:11px 12px;border-radius:10px;display:flex;justify-content:center;align-items:center;gap:8px}
details.sys summary::-webkit-details-marker{display:none}
details.sys summary:focus-visible{outline:2px solid var(--fg);outline-offset:-3px}
.chev{width:7px;height:7px;border-right:2px solid var(--muted);border-bottom:2px solid var(--muted);transform:rotate(45deg);margin-top:-4px;transition:transform .15s,margin .15s}
details[open] .chev{transform:rotate(-135deg);margin-top:4px}
.tiles{display:grid;border-top:1px solid var(--border)}
.tiles.five{grid-template-columns:repeat(5,minmax(0,1fr))}
.tiles.three{grid-template-columns:repeat(3,minmax(0,1fr))}
.tile{min-width:0;text-align:center;padding:12px 3px}
.tile+.tile{border-left:1px solid var(--border)}
.tile .lab{font-size:8.5px;letter-spacing:.04em;overflow-wrap:anywhere}
.tile .v{font-size:12px;font-weight:600;margin-top:4px;overflow-wrap:anywhere;hyphens:auto}
@media (min-width:600px){.tile{padding:14px 10px}.tile .lab{font-size:10.5px;letter-spacing:.07em}.tile .v{font-size:14px}}
.rows{display:flex;flex-direction:column}
.row{padding:9px 0;border-bottom:1px solid var(--border)}
.row:last-of-type{border-bottom:0}
.rt{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:7px}
.rt span{min-width:0}
.num{display:flex;align-items:center;gap:3px;color:var(--muted);flex:none}
.num input{width:62px;text-align:right;font:inherit;font-variant-numeric:tabular-nums;color:var(--fg);background:var(--card);border:1px solid var(--border);border-radius:6px;padding:3px 6px}
.num input[readonly]{background:var(--soft);color:var(--muted);cursor:not-allowed}
input[type=range]{-webkit-appearance:none;appearance:none;width:100%;height:20px;margin:0;background:transparent;cursor:pointer;display:block}
input[type=range]::-webkit-slider-runnable-track{height:8px;border-radius:99px;background:linear-gradient(to right,var(--c) var(--p),var(--track) var(--p))}
input[type=range]::-moz-range-track{height:8px;border-radius:99px;background:var(--track)}
input[type=range]::-moz-range-progress{height:8px;border-radius:99px;background:var(--c)}
input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:18px;height:18px;border-radius:50%;background:#fff;border:2px solid var(--c);margin-top:-5px;cursor:pointer;box-shadow:0 1px 3px rgba(0,0,0,.3)}
input[type=range]::-moz-range-thumb{width:14px;height:14px;border-radius:50%;background:#fff;border:2px solid var(--c);cursor:pointer}
input[type=range]:active{cursor:pointer}
input[type=range]:disabled{cursor:not-allowed;opacity:.9}
input[type=range].lock::-webkit-slider-runnable-track{background:repeating-linear-gradient(135deg,var(--track) 0 5px,var(--card) 5px 8px);border:1px dashed var(--muted)}
input[type=range].lock::-moz-range-track{background:repeating-linear-gradient(135deg,var(--track) 0 5px,var(--card) 5px 8px);border:1px dashed var(--muted)}
input[type=range].lock::-webkit-slider-thumb{display:none}
input[type=range].lock::-moz-range-thumb{display:none}
input[type=range].lock::-moz-range-progress{background:transparent}
.btns{display:flex;flex-wrap:wrap;justify-content:center;gap:6px}
button{display:inline-flex;align-items:center;gap:6px;font:inherit;font-size:12.5px;cursor:pointer;color:var(--fg);background:var(--card);border:1px solid var(--border);border-radius:7px;padding:4px 10px;line-height:1.3}
button:hover{background:var(--soft)}
button.on{background:var(--fg);color:var(--card);border-color:var(--fg)}
.reset{display:flex;justify-content:center;margin-top:10px}
.hemi{display:block;width:100%;max-width:540px;margin:0 auto}
.legend{display:flex;flex-wrap:wrap;justify-content:center;gap:6px 14px;margin:16px 0 14px}
.legend span{display:inline-flex;align-items:center;gap:5px;font-size:12.5px}
.dot{width:10px;height:10px;border-radius:50%;display:inline-block;flex:none}
table{width:100%;border-collapse:collapse;font-variant-numeric:tabular-nums}
th{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;font-weight:600;padding:6px 6px;border-bottom:1px solid var(--border)}
td{padding:8px 6px;border-bottom:1px solid var(--border);vertical-align:middle}
tr:last-child td{border-bottom:0}
th:first-child,td:first-child{text-align:left}
th:not(:first-child),td:not(:first-child){text-align:right;white-space:nowrap}
td.s{font-weight:700}
td .dot{margin-right:6px}
.pos{color:var(--green)}.neg{color:var(--red)}.zero{color:var(--muted)}
.cbar{position:relative;height:14px;border-radius:99px;background:var(--track);margin:30px 6px 26px}
.cbar .seg{position:absolute;top:0;height:100%}
.cbar .fillwrap{position:absolute;inset:0;border-radius:99px;overflow:hidden}
.cbar .mk{position:absolute;top:-6px;bottom:-6px;width:2px;background:var(--fg);transform:translateX(-1px)}
.cbar .mkl{position:absolute;top:22px;transform:translateX(-50%);font-size:11px;color:var(--muted);font-variant-numeric:tabular-nums;margin-top:6px}
.cstat{text-align:center;font-size:13px;font-variant-numeric:tabular-nums}
.cstat b.maj{color:var(--green)}
.mapwrap{position:relative;max-width:650px;margin:12px auto 0;aspect-ratio:650/470;overflow:hidden}
.mapwrap svg{display:block;width:100%;height:100%;touch-action:pan-y;user-select:none;-webkit-user-select:none}
.zoom{position:absolute;bottom:4px;right:4px;display:flex;gap:2px;z-index:4;opacity:.5;transition:opacity .15s}
.zoom:hover,.zoom:focus-within{opacity:1}
.zoom button{justify-content:center;min-width:24px;height:22px;padding:0 6px;font-size:13px;line-height:20px;color:var(--muted);background:transparent;border:1px solid transparent;border-radius:6px}
.zoom button:hover{background:var(--soft);border-color:var(--border);color:var(--fg)}
.zoom button.rs{font-size:10.5px}
.cons path{stroke:var(--card);stroke-width:.8px;vector-effect:non-scaling-stroke;stroke-linejoin:round;cursor:pointer;outline:none;transition:filter .1s}
.cons path:hover,.cons path.sel{filter:brightness(.86)}
.cons path:focus{outline:none}
.tip{position:absolute;z-index:5;width:172px;background:var(--card);border:1px solid var(--border);border-radius:8px;box-shadow:var(--shadow);padding:8px 10px;font-size:12px;display:none}
.tip .t{display:flex;justify-content:space-between;gap:6px;font-weight:650;margin-bottom:5px;font-size:12.5px;line-height:1.25}
.tip .t em{font-style:normal;color:var(--muted);font-weight:500;white-space:nowrap}
.tip .r{display:flex;align-items:center;gap:6px;padding:2px 0;font-variant-numeric:tabular-nums}
.tip .r b.p{margin-left:auto}
.tip .r.w{font-weight:700}
.tip .r:not(.w){font-weight:400}
.mlegend{display:flex;flex-wrap:wrap;justify-content:center;gap:6px 14px;margin:12px 0 2px;align-items:center;font-size:12.5px}
.mlegend span{display:inline-flex;align-items:center;gap:5px}
.grad{display:flex;align-items:center;gap:8px;font-variant-numeric:tabular-nums}
.grad i{display:block;width:150px;height:10px;border-radius:99px;border:1px solid var(--border)}
.src{font-size:11px;color:var(--muted);text-align:center;margin:14px 4px 0;line-height:1.5}
@media (max-width:420px){.big{font-size:23px}h1{font-size:20px}td{padding:8px 4px}.card{padding:10px}.grad i{width:110px}}
</style>
</head>
