/* ---------- projection: universal national swing ---------- */
function nationalInputs(){
  var other=Math.max(0,100-inp.NDP-inp.ULP), x={};
  x.NDP=inp.NDP; x.ULP=inp.ULP;
  minors.forEach(function(p){x[p.id]=other*B[p.id]/BM;});
  return {x:x,other:other};
}
function project(){
  var ni=nationalInputs(), x=ni.x, res=[], seats={}, gains=0;
  PARTIES.forEach(function(p){seats[p.id]=0;});
  CONS.forEach(function(c){
    var raw={},S=0;
    PARTIES.forEach(function(p){
      var b=B[p.id], t=0.2*b, v;
      if(x[p.id]>=t) v=c.base[p.id]+(x[p.id]-b);
      else v=(c.base[p.id]+(t-b))*(x[p.id]/t);
      if(v<0||!isFinite(v)) v=0; raw[p.id]=v; S+=v;
    });
    var sh={}; PARTIES.forEach(function(p){sh[p.id]=S>0?raw[p.id]/S*100:0;});
    var w=argmax(sh); seats[w]++;
    res.push({c:c,share:sh,win:w,gain:w!==c.w25});
  });
  return {x:x,other:ni.other,seats:seats,cons:res};
}

/* ---------- helpers ---------- */
function f1(n){return n.toFixed(1);}
