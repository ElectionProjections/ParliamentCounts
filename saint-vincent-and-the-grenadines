/* ---------- inputs ---------- */
var rowsEl=document.getElementById('rows'), ctl={};
function buildInputs(){
  PARTIES.filter(function(p){return p.slider;}).forEach(function(p){
    var row=el('div',{'class':'row'});
    row.appendChild(el('div',{'class':'nm'},p.name+' ('+p.id+')'));
