/* ---------- hemicycle ---------- */
var HEMI=(function(){
  var cx=130,cy=112,rows=[{r:52,n:6},{r:84,n:9}],seats=[];
  rows.forEach(function(row,ri){for(var k=0;k<row.n;k++){var th=Math.PI*(1-k/(row.n-1));seats.push({x:cx+row.r*Math.cos(th),y:cy-row.r*Math.sin(th),th:th,r:row.r});}});
