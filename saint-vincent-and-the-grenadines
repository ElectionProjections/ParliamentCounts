    p.addEventListener('click',function(e){e.stopPropagation();showTip(id,e);});
    mapEl.appendChild(p);areaEls[id]=p;
  });
}
function mix(p,t){return 'color-mix(in srgb,'+pc(p)+' '+(12+88*t).toFixed(1)+'%,var(--ramp-low))';}
function drawMap(){
  var btns=document.getElementById('mbtns');btns.innerHTML='';
  var opts=[{k:'winner',t:'Winner'},{k:'gains',t:'Gains'}];
  ordered().filter(shown).forEach(function(p){opts.push({k:p.id,t:p.id,d:p});});
  if(mode!=='winner'&&mode!=='gains'&&!shown(pById[mode]))mode='winner';
  opts.forEach(function(o){
    var b=el('button',{type:'button','class':mode===o.k?'on':''},(o.d?'<i class="dot" style="background:'+pc(o.d)+'"></i>':'')+o.t);
    b.addEventListener('click',function(){mode=o.k;drawMap();});btns.appendChild(b);
  });
  var lg=document.getElementById('mlegend');lg.innerHTML='';
  var mn=0,mx=0;
  if(mode!=='winner'&&mode!=='gains'){
    var vals=R.cons.map(function(r){return r.share[mode];});mn=Math.min.apply(null,vals);mx=Math.max.apply(null,vals);
  }
  R.cons.forEach(function(r){
    var a=areaEls[r.c.id],fill;
    if(mode==='winner')fill=pc(pById[r.win]);
    else if(mode==='gains')fill=r.gain?pc(pById[r.win]):'var(--none)';
    else{var t=mx>mn?(r.share[mode]-mn)/(mx-mn):1;fill=mix(pById[mode],t);}
    a.style.fill=fill;
  });
  if(mode==='winner'){
    HEMI_ORDER.forEach(function(id){if(R.seats[id]>0)lg.appendChild(el('span',{style:'display:inline-flex;align-items:center;gap:6px'},'<i style="width:11px;height:11px;border-radius:50%;display:inline-block;background:'+pc(pById[id])+'"></i>'+id));});
  }else if(mode==='gains'){
    var g={};R.cons.forEach(function(r){if(r.gain)g[r.win]=true;});
    var ks=HEMI_ORDER.filter(function(id){return g[id];});
    if(!ks.length)lg.textContent='None';
    ks.forEach(function(id){lg.appendChild(el('span',{style:'display:inline-flex;align-items:center;gap:6px'},'<i style="width:11px;height:11px;border-radius:50%;display:inline-block;background:'+pc(pById[id])+'"></i>'+id));});
  }else{
    var p=pById[mode];
    var cb=el('div',{'class':'cbar'},'<span>'+f1(mn)+'%</span><i style="background:linear-gradient(to right,'+mix(p,0)+','+mix(p,1)+')"></i><span>'+f1(mx)+'%</span>');
    lg.appendChild(cb);
  }
  if(openArea)fillTip(openArea);
}
var tip=document.getElementById('tip'), wrap=document.getElementById('mapwrap');
function fillTip(id){
  var r=R.cons.filter(function(q){return q.c.id===id;})[0];
  var rows=PARTIES.filter(function(p){return r.share[p.id]>=1||p.id===r.win;}).sort(function(a,b){return r.share[b.id]-r.share[a.id];});
  tip.innerHTML='<div class="th">'+r.c.name+'</div>'+rows.map(function(p){return '<div class="tr'+(p.id===r.win?' w':'')+'"><span><i class="dot" style="background:'+pc(p)+'"></i>'+p.id+'</span><span>'+f1(r.share[p.id])+'%</span></div>';}).join('');
}
function showTip(id,e){
  openArea=id;fillTip(id);
  Object.keys(areaEls).forEach(function(k){areaEls[k].classList.toggle('sel',k===id);});
  tip.style.display='block';
  var wb=wrap.getBoundingClientRect(), x=e.clientX-wb.left, y=e.clientY-wb.top;
  var tw=tip.offsetWidth, th=tip.offsetHeight;
  var left=Math.min(Math.max(4,x+10),wb.width-tw-4), top=Math.min(Math.max(4,y+10),wb.height-th-4);
  tip.style.left=left+'px';tip.style.top=top+'px';
}
function hideTip(){openArea=null;tip.style.display='none';Object.keys(areaEls).forEach(function(k){areaEls[k].classList.remove('sel');});}
document.addEventListener('click',function(e){if(!tip.contains(e.target))hideTip();});

/* ---------- zoom / pan ---------- */
(function(){
  var vbv=mapEl.viewBox.baseVal, M={x:vbv.x,y:vbv.y,w:vbv.width,h:vbv.height}, BASE={x:0,y:0,w:1,h:1}, V={x:0,y:0,w:1,h:1}, MAXZ=14, moved=false, ptrs={};
  function setBase(){var r=mapEl.getBoundingClientRect();if(!r.width||!r.height)return;var a=r.width/r.height,w=M.h*a,h=M.h;if(w<M.w){w=M.w;h=w/a;}BASE={x:M.x+M.w/2-w/2,y:M.y+M.h/2-h/2,w:w,h:h};V={x:BASE.x,y:BASE.y,w:BASE.w,h:BASE.h};apply();}
  var zr=document.getElementById('zreset');
  function apply(){
    var z=BASE.w/V.w;
    mapEl.setAttribute('viewBox',V.x+' '+V.y+' '+V.w+' '+V.h);
    mapEl.classList.toggle('zoomed',z>1.001);zr.hidden=!(z>1.001);
  }
  function clampV(){
    V.w=Math.min(BASE.w,Math.max(BASE.w/MAXZ,V.w));V.h=V.w*BASE.h/BASE.w;
    V.x=Math.min(BASE.x+BASE.w-V.w,Math.max(BASE.x,V.x));
    V.y=Math.min(BASE.y+BASE.h-V.h,Math.max(BASE.y,V.y));
  }
  function zoomAt(cx,cy,f){
    var r=mapEl.getBoundingClientRect(),px=V.x+cx/r.width*V.w,py=V.y+cy/r.height*V.h;
    V.w=V.w/f;clampV();
    V.x=px-cx/r.width*V.w;V.y=py-cy/r.height*V.h;clampV();apply();hideTip();
  }
  mapEl.addEventListener('wheel',function(e){
    e.preventDefault();var r=mapEl.getBoundingClientRect();
    zoomAt(e.clientX-r.left,e.clientY-r.top,Math.exp(-e.deltaY*(e.deltaMode===1?0.05:0.0016)));
  },{passive:false});
  mapEl.addEventListener('pointerdown',function(e){ptrs[e.pointerId]={x:e.clientX,y:e.clientY,d:0};moved=false;});
  window.addEventListener('pointermove',function(e){
    var p=ptrs[e.pointerId];if(!p)return;
    var ids=Object.keys(ptrs),r=mapEl.getBoundingClientRect(),bx=p.x,by=p.y;
    p.x=e.clientX;p.y=e.clientY;
    if(ids.length>=2){
      var o=ptrs[ids[0]]===p?ptrs[ids[1]]:ptrs[ids[0]];
      var d0=Math.hypot(bx-o.x,by-o.y),d1=Math.hypot(p.x-o.x,p.y-o.y);
      if(d0>0){zoomAt((p.x+o.x)/2-r.left,(p.y+o.y)/2-r.top,d1/d0);}
      moved=true;return;
    }
    if(BASE.w/V.w<=1.001)return;
    var dx=p.x-bx,dy=p.y-by;p.d+=Math.abs(dx)+Math.abs(dy);
    if(p.d>4){moved=true;V.x-=dx/r.width*V.w;V.y-=dy/r.height*V.h;clampV();apply();hideTip();}
  });
  function up(e){delete ptrs[e.pointerId];}
  window.addEventListener('pointerup',up);window.addEventListener('pointercancel',up);
  mapEl.addEventListener('click',function(e){if(moved){e.stopPropagation();e.preventDefault();moved=false;}},true);
  zr.addEventListener('click',function(e){e.stopPropagation();V={x:BASE.x,y:BASE.y,w:BASE.w,h:BASE.h};apply();hideTip();});
  setBase();window.addEventListener('resize',setBase);
})();

/* ---------- render ---------- */
function render(){
  R=project();
  drawHemi();drawTable();drawBuilder();drawMap();
}
document.getElementById('reset').addEventListener('click',function(){inp.NDP=B.NDP;inp.ULP=B.ULP;syncInputs();render();});
buildInputs();buildMap();syncInputs();render();
window.__proj={project:function(a,b){var o={NDP:inp.NDP,ULP:inp.ULP};inp.NDP=a;inp.ULP=b;var r=project();inp.NDP=o.NDP;inp.ULP=o.ULP;return r;},B:B,PARTIES:PARTIES,CONS:CONS};
})();
</script>
