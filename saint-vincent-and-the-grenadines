<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>St Vincent Seat Projector</title>
<style>
:root{
  --bg:#f4f5f7;--card:#ffffff;--text:#1c2127;--muted:#667085;--border:#d8dce3;--track:#d3d8e0;--soft:#eef0f4;
  --land:#aeb6c2;--ramp-low:#eceff3;--none:#e3e6eb;--good:#1a7f37;--bad:#c62828;--amber:#d99200;--red:#d93025;
  --ndp:#FFCC29;--ulp:#E2231A;--nlm:#7B3FA0;--ind:#8A8F98;
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --bg:#14171b;--card:#1d2127;--text:#e9ecf0;--muted:#9aa4b1;--border:#363d47;--track:#59616d;--soft:#272d35;
    --land:#4b5563;--ramp-low:#333a44;--none:#2c333c;--good:#4cc36a;--bad:#ff6b63;--amber:#f0b429;--red:#ef4b41;
  }
}
:root[data-theme="dark"]{
  --bg:#14171b;--card:#1d2127;--text:#e9ecf0;--muted:#9aa4b1;--border:#363d47;--track:#59616d;--soft:#272d35;
  --land:#4b5563;--ramp-low:#333a44;--none:#2c333c;--good:#4cc36a;--bad:#ff6b63;--amber:#f0b429;--red:#ef4b41;
}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--text);font:15px/1.4 system-ui,-apple-system,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;font-variant-numeric:tabular-nums}
main{max-width:760px;margin:0 auto;padding:18px 16px 40px}
h1{font-size:1.45rem;text-align:center;margin:6px 0 14px;font-weight:700;letter-spacing:-.01em}
h2{font-size:1.12rem;text-align:center;margin:0 0 12px;font-weight:650}
.card{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:16px;margin:0 0 14px}
.locator{display:flex;justify-content:center;align-items:center;gap:16px;height:90px;margin:0 0 12px}
.locator svg{display:block}
.world{width:220px;height:auto;max-width:60%}
.flag{width:50px;height:auto;border:1px solid var(--border);border-radius:3px;display:block}
.facts{display:grid;grid-template-columns:1fr 1fr;padding:14px 0;text-align:center}
.facts>div{padding:0 12px;min-width:0}
.facts>div+div{border-left:1px solid var(--border)}
.lab{font-size:.68rem;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
.big{font-size:1.7rem;font-weight:700;line-height:1.15;margin:3px 0}
.big small{font-size:.9rem;font-weight:500;color:var(--muted)}
.sub{font-size:.76rem;color:var(--muted)}
.fhbar{height:6px;border-radius:3px;background:var(--track);margin:6px auto 6px;max-width:170px;overflow:hidden}
.fhbar i{display:block;height:100%;border-radius:3px}
details.sys{padding:0}
details.sys summary{list-style:none;cursor:pointer;text-align:center;font-weight:600;padding:12px 16px;display:flex;justify-content:center;align-items:center;gap:8px;border-radius:12px}
details.sys summary::-webkit-details-marker{display:none}
details.sys summary:focus-visible{outline:2px solid var(--text);outline-offset:-3px}
details.sys summary::after{content:"";width:7px;height:7px;border-right:2px solid var(--muted);border-bottom:2px solid var(--muted);transform:rotate(45deg) translateY(-2px);transition:transform .15s}
details.sys[open] summary::after{transform:rotate(-135deg) translateY(-2px)}
.tiles{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));border-top:1px solid var(--border)}
.tiles.t3{grid-template-columns:repeat(2,minmax(0,1fr))}
.tile{text-align:center;padding:12px 3px;min-width:0;overflow-wrap:anywhere}
.tile+.tile{border-left:1px solid var(--border)}
.tile .lab{font-size:.56rem;letter-spacing:.05em;margin-bottom:4px}
.tile .val{font-size:.74rem;font-weight:600;line-height:1.25;overflow-wrap:break-word;hyphens:manual}
.tiles+.tiles{}
@media(min-width:600px){.tile{padding:14px 10px}.tile .lab{font-size:.66rem;letter-spacing:.07em}.tile .val{font-size:.92rem}}
/* inputs */
.rows{display:flex;flex-direction:column;gap:14px;margin:4px 0 14px}
.row{display:grid;grid-template-columns:minmax(0,1fr) 74px;gap:6px 12px;align-items:center}
.row .nm{grid-column:1/-1;font-size:.9rem}
@media(min-width:560px){.row{grid-template-columns:minmax(0,230px) minmax(0,1fr) 74px;gap:12px}.row .nm{grid-column:auto}}
.rng{-webkit-appearance:none;appearance:none;width:100%;height:20px;margin:0;background:transparent;cursor:pointer;--c:#888;--p:0%}
.rng::-webkit-slider-runnable-track{height:8px;border-radius:4px;background:linear-gradient(to right,var(--c) var(--p),var(--track) var(--p))}
.rng::-moz-range-track{height:8px;border-radius:4px;background:linear-gradient(to right,var(--c) var(--p),var(--track) var(--p))}
.rng::-webkit-slider-thumb{-webkit-appearance:none;appearance:none;width:20px;height:20px;border-radius:50%;background:#fff;border:2px solid var(--c);margin-top:-6px;cursor:pointer;box-shadow:0 1px 3px rgba(0,0,0,.35)}
.rng::-moz-range-thumb{width:16px;height:16px;border-radius:50%;background:#fff;border:2px solid var(--c);cursor:pointer;box-shadow:0 1px 3px rgba(0,0,0,.35)}
.rng:active,.rng:active::-webkit-slider-thumb{cursor:pointer}
.rng:focus{outline:none}
.rng.lock{cursor:not-allowed;pointer-events:none}
.rng.lock::-webkit-slider-runnable-track{background:repeating-linear-gradient(135deg,var(--track) 0 5px,var(--card) 5px 9px);border:1px solid var(--track)}
.rng.lock::-moz-range-track{background:repeating-linear-gradient(135deg,var(--track) 0 5px,var(--card) 5px 9px);border:1px solid var(--track)}
.rng.lock::-webkit-slider-thumb{visibility:hidden}
.rng.lock::-moz-range-thumb{visibility:hidden}
.box{display:flex;align-items:center;border:1px solid var(--border);border-radius:7px;background:var(--card);padding:0 8px;height:32px}
.box input{width:100%;min-width:0;border:0;background:transparent;color:var(--text);font:inherit;text-align:right;padding:0;outline:none}
.box span{color:var(--muted);margin-left:2px}
.box:focus-within{border-color:var(--muted)}
.box.lock{background:var(--soft);color:var(--muted);cursor:not-allowed}
.box.lock input{cursor:not-allowed;color:var(--muted)}
.btns{display:flex;justify-content:center;flex-wrap:wrap;gap:6px}
button{font:inherit;font-size:.8rem;border:1px solid var(--border);background:var(--card);color:var(--text);border-radius:7px;padding:4px 11px;cursor:pointer}
button:hover{background:var(--soft)}
button.on{background:var(--text);color:var(--card);border-color:var(--text)}
.reset{display:block;margin:0 auto}
.dot{display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:6px;flex:none}
.btns button{display:inline-flex;align-items:center}
.btns button .dot{margin-right:5px}
/* results */
.hemi{width:100%;max-width:650px;margin:0 auto;display:block;height:auto}
.legend{display:flex;justify-content:center;flex-wrap:wrap;gap:6px 16px;margin:16px 0 14px;font-size:.82rem}
.legend span{display:inline-flex;align-items:center;gap:6px}
.legend i{width:11px;height:11px;border-radius:50%;display:inline-block}
table{width:100%;border-collapse:collapse;font-size:.9rem}
th{font-size:.68rem;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);font-weight:600;padding:6px 6px;text-align:right;border-bottom:1px solid var(--border)}
td{padding:10px 6px;text-align:right;border-bottom:1px solid var(--border)}
th:first-child,td:first-child{text-align:left}
tr:last-child td{border-bottom:0}
td.seats{font-weight:700}
.pos{color:var(--good)}.neg{color:var(--bad)}.zero{color:var(--muted)}
/* builder */
.bar{position:relative;height:16px;border-radius:8px;background:var(--track);margin:26px 0 0}
.bar .fill{position:absolute;inset:0;display:flex;overflow:hidden;border-radius:8px}
.bar .seg{height:100%}
.mark{position:absolute;top:-6px;bottom:-6px;width:2px;background:var(--text);transform:translateX(-1px)}
.mark b{position:absolute;top:100%;left:50%;transform:translateX(-50%);font-size:.7rem;font-weight:600;margin-top:2px}
.bcount{text-align:center;margin-top:30px;font-size:.88rem}
.bcount em{font-style:normal;color:var(--good);font-weight:650;margin-left:8px}
/* map */
.mapwrap{position:relative;width:100%;height:675px;margin:0 auto;overflow:hidden;border-radius:8px}
.map{width:100%;height:100%;display:block;touch-action:pan-y}
.map.zoomed{touch-action:none}
.zreset{position:absolute;top:6px;right:6px;z-index:4}
.zreset[hidden]{display:none}
.area{cursor:pointer;stroke:var(--card);stroke-width:1;vector-effect:non-scaling-stroke;stroke-linejoin:round;outline:none}
.area:hover,.area.sel{filter:brightness(.88)}
.map *:focus{outline:none}
.tip{position:absolute;z-index:5;min-width:150px;max-width:190px;background:var(--card);color:var(--text);border:1px solid var(--border);border-radius:8px;box-shadow:0 4px 14px rgba(0,0,0,.25);padding:7px 10px;font-size:.78rem;display:none}
.tip .th{display:flex;justify-content:space-between;gap:10px;font-weight:650;margin-bottom:5px}
.tip .th span{color:var(--muted);font-weight:500;white-space:nowrap}
.tip .tr{display:flex;justify-content:space-between;padding:1px 0}
.tip .tr.w{font-weight:700}
.mlegend{display:flex;justify-content:center;align-items:center;flex-wrap:wrap;gap:6px 16px;margin-top:14px;font-size:.82rem;min-height:22px}
.cbar{display:flex;align-items:center;gap:8px}
.cbar i{display:block;width:150px;height:10px;border-radius:5px}
.sources{font-size:.7rem;color:var(--muted);text-align:center;margin:18px 0 0}
.sources a{color:inherit}
</style>
</head>
