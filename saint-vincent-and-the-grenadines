function setVal(id,v,typing){
  var o=id==='NDP'?'ULP':'NDP';
  v=Math.round(v*10)/10; if(v<0)v=0; var mx=Math.min(80,100-inp[o]); if(v>mx)v=Math.floor(mx*10+1e-9)/10; if(v>mx)v=mx;
